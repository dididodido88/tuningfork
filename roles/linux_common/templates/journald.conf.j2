# {{ ansible_managed }}
# Managed by the linux_common role. CIS rule 6.2.1.3 is handed over to this role.
[Journal]
Storage={{ linux_common_journald_storage }}
Compress={{ 'yes' if linux_common_journald_compress | bool else 'no' }}
MaxRetentionSec={{ linux_common_journald_max_retention }}
MaxFileSec={{ linux_common_journald_max_file_sec }}
SystemMaxUse={{ linux_common_journald_system_max_use }}
SystemKeepFree={{ linux_common_journald_system_keep_free }}
RuntimeMaxUse={{ linux_common_journald_runtime_max_use }}
