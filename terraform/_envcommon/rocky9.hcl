# Rocky Linux 9 settings shared by every environment. Included by live/<ENV>/rocky9/terragrunt.hcl:
#   include "envcommon" { path = ".../_envcommon/rocky9.hcl", merge_strategy = "deep" }
#
# The VMs are cloned from a prepared Rocky 9 template (cloud-init + qemu-guest-agent installed,
# cloud-init drive removed or regenerated by Proxmox). Its VM ID is set per environment in env.hcl.

locals {
  env = read_terragrunt_config(find_in_parent_folders("env.hcl")).locals
}

terraform {
  source = "${dirname(find_in_parent_folders("root.hcl"))}/modules/proxmox-vm"
}

inputs = {
  template_vm_id     = local.env.rocky9_template_vm_id
  template_node_name = local.env.rocky9_template_node_name

  os_type  = "l26"
  cpu_type = "x86-64-v2-AES"

  default_cores      = 2
  default_memory_mb  = 4096
  default_os_disk_gb = 40

  # Same account as ansible_user in ansible/inventories/<ENV>/group_vars/linux.yml.
  ci_user = "ansible"

  tags = ["rocky9", "terraform", lower(local.env.env_name)]

  # Generated inventory: hosts land in linux -> rocky9 plus their ansible_groups.
  inventory_path            = "${get_repo_root()}/ansible/inventories/${local.env.env_name}/terraform_rocky9.yml"
  inventory_os_group        = "rocky9"
  inventory_os_parent_group = "linux"
}
