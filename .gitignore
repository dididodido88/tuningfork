# Fact cache and other local Ansible state (see ansible.cfg)
.ansible/
*.retry

# Vault password files - never commit
.vault_pass*
*.vault_pass

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Terraform / Terragrunt
# Local state holds VM details and must not be committed; back terraform/state/ up separately.
terraform/state/
*.tfstate
*.tfstate.*
.terraform/
.terragrunt-cache/
# Providers are supplied out of band (see terraform/README.md).
terraform/providers/*
!terraform/providers/.gitkeep
# Keep .terraform.lock.hcl files: commit them.

# Python bytecode (Ansible filter plugins compile here when run)
__pycache__/
*.pyc

# Certificate scripts: a passphrase file next to them holds a CA secret, never commit one.
# (rootCA/passphrase.txt is notes only and stays tracked.)
scripts/certificates/**/passphrase*
!scripts/certificates/rootCA/passphrase.txt
