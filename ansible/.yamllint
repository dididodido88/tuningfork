---
extends: default
ignore: |
  collections/
  roles/RHEL9-CIS/
  .ansible/
  # Generated by Terraform (yamlencode has its own indentation).
  inventories/*/terraform_*.yml
  # Ansible Vault files are encrypted, not YAML.
  inventories/*/group_vars/all/vault.yml
rules:
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
