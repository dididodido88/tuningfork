---
# Vendored content is linted upstream, not here.
exclude_paths:
  - collections/
  - roles/RHEL9-CIS/
  - .ansible/
  # Generated by Terraform.
  - inventories/*/terraform_*.yml
profile: moderate
# Air gap: don't install requirements.yml from the internet before linting (RHEL9-CIS is vendored).
offline: true
