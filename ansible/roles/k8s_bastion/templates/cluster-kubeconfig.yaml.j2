# {{ ansible_managed }} (roles/k8s_bastion)
# Shared definition of cluster '{{ item.name }}': cluster and context only, no credentials.
# Add yours once (stored in ~/.kube/config), e.g. with a token:
#   kubectl config set-credentials {{ item.name }} --token=<token>
#   kubectl config use-context {{ item.name }}
apiVersion: v1
kind: Config
clusters:
  - name: {{ item.name }}
    cluster:
      server: {{ item.server }}
      certificate-authority: {{ item.ca_file | default('/etc/pki/tls/certs/ca-bundle.crt') }}
contexts:
  - name: {{ item.name }}
    context:
      cluster: {{ item.name }}
      user: {{ item.name }}
      namespace: {{ item.namespace | default('default') }}
