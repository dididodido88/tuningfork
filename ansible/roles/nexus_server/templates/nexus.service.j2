# {{ ansible_managed }}
[Unit]
Description=Sonatype Nexus Repository
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
LimitNOFILE=65536
User={{ nexus_server_user }}
Group={{ nexus_server_group }}
ExecStart={{ nexus_server_link }}/bin/nexus start
ExecStop={{ nexus_server_link }}/bin/nexus stop
Restart=on-abort
TimeoutSec=600

[Install]
WantedBy=multi-user.target
