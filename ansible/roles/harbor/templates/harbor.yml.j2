# {{ ansible_managed }} (roles/harbor). Local changes are overwritten.
# Reference: harbor.yml.tmpl in the offline installer ({{ harbor_version }}).

hostname: {{ harbor_hostname }}

# http only redirects to https.
http:
  port: 80

https:
  port: 443
  certificate: {{ harbor_tls_certificate }}
  private_key: {{ harbor_tls_key }}

# Used only when Harbor starts for the first time; later changes are made in Harbor itself.
harbor_admin_password: {{ harbor_admin_password | to_json }}

database:
  password: {{ harbor_db_password | to_json }}
  max_idle_conns: 100
  max_open_conns: 900
  conn_max_idle_time: 0

data_volume: {{ harbor_data_dir }}

trivy:
  # Air-gapped: never download the vulnerability database (docs/harbor.md, "Trivy").
  ignore_unfixed: false
  skip_update: true
  skip_java_db_update: true
  offline_scan: true
  security_check: vuln
  insecure: false

jobservice:
  max_job_workers: 10
  job_loggers:
    - STD_OUTPUT
    - FILE
  logger_sweeper_duration: 1

notification:
  webhook_job_max_retry: 3
  webhook_job_http_client_timeout: 3

log:
  level: info
  local:
    rotate_count: 50
    rotate_size: 200M
    location: {{ harbor_log_dir }}

_version: {{ harbor_config_version }}

proxy:
  http_proxy:
  https_proxy:
  no_proxy:
  components:
    - core
    - jobservice
    - trivy

upload_purging:
  enabled: true
  age: 168h
  interval: 24h
  dryrun: false

cache:
  enabled: false
  expire_hours: 24
