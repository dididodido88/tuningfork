# {{ ansible_managed }} (roles/harbor)
# Docker Compose merges this file with docker-compose.yml (generated by Harbor's prepare).
# harbor-core and jobservice are Go programs: SSL_CERT_FILE makes them trust the host's CA
# bundle, which includes the internal root CA (certificates role). Needed for LDAPS to the
# DCs and for webhooks/replication to internal HTTPS services.
services:
  core:
    environment:
      SSL_CERT_FILE: /etc/harbor-host-ca/tls-ca-bundle.pem
    volumes:
      - {{ harbor_trust_bundle_dir }}:/etc/harbor-host-ca:ro
  jobservice:
    environment:
      SSL_CERT_FILE: /etc/harbor-host-ca/tls-ca-bundle.pem
    volumes:
      - {{ harbor_trust_bundle_dir }}:/etc/harbor-host-ca:ro
