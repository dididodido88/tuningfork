# {{ ansible_managed }} (roles/pve_exporter)
[Unit]
Description=Prometheus Proxmox VE exporter
After=network-online.target
Wants=network-online.target

[Service]
User={{ pve_exporter_user }}
Group={{ pve_exporter_user }}
# Check the Proxmox API certificate against the system trust store (internal CA), not the
# bundle shipped with the Python packages.
Environment=REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
ExecStart={{ pve_exporter_venv }}/bin/pve_exporter \
  --config.file /etc/pve-exporter/pve.yml \
  --web.listen-address {{ pve_exporter_listen_address }}:{{ pve_exporter_port }}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
