# {{ ansible_managed }} (roles/sssd_ad). Local changes are overwritten.
[sssd]
domains = {{ sssd_ad_domain }}
services = nss, pam

[nss]
# Never look up root in AD.
filter_users = root
filter_groups = root

[domain/{{ sssd_ad_domain }}]
id_provider = ad
auth_provider = ad
chpass_provider = ad
ad_domain = {{ sssd_ad_domain }}
krb5_realm = {{ sssd_ad_realm }}
{% if sssd_ad_servers | length > 0 %}
ad_server = {{ sssd_ad_servers | join(', ') }}
{% endif %}

# POSIX IDs come from uidNumber/gidNumber in AD (same IDs on every host), not from SIDs.
ldap_id_mapping = False
# The global catalog may not hold the POSIX attributes; read them from the domain.
ad_enable_gc = False
min_id = {{ sssd_ad_min_id }}

# Short names (jdoe, linux-admins); local accounts win a name clash (nsswitch: files sss).
use_fully_qualified_names = False
override_homedir = {{ sssd_ad_homedir }}
default_shell = {{ sssd_ad_shell }}

# Only members of these AD groups may log in. Local users aren't affected.
access_provider = simple
simple_allow_groups = {{ (sssd_ad_ssh_groups + sssd_ad_admin_groups) | unique | join(', ') }}
# Don't apply Windows logon-right GPOs to Linux hosts.
ad_gpo_access_control = disabled

cache_credentials = {{ sssd_ad_cache_credentials | bool }}
krb5_store_password_if_offline = {{ sssd_ad_cache_credentials | bool }}
# Hosts have static addresses registered in DNS; don't update DNS from the host.
dyndns_update = False
